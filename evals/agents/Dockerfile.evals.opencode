# OpenCode CLI, plus the toolchain of the skills (tesseract, OpenCV, pypdfium2, pyproj), for the agent benchmark in
# evals/agents/ under hard resource limits. The five images (claude, codex, gemini, opencode, qoder) differ only in
# the agent's CLI and its settings, so the runs compare agents and models, not environments; keep the shared lines in
# step (test_dockerfiles.py checks them). Adapted from GeoAI-master-skills.
# Build (from the repository root):  docker build -f evals/agents/Dockerfile.evals.opencode -t geo-ref-skills-evals-opencode .
# Run:    evals/agents/run_opencode_docker.sh <workdir>     (the limits are set there, not here)
# Pinned inputs, so a later rebuild gives the same toolchain: the base images by digest, the CLI by version, the
# Python packages from evals/agents/requirements-evals.lock. Only the Debian packages come from apt at build time.
FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258

# Pinned for reproducibility; override with --build-arg OPENCODE_VERSION=... (and the two digests) and record it
# with the results. The digests are the ones GitHub publishes for the v1.19.3 assets (checked in GeoAI-master-skills
# against the downloads on 2026-10-17).
ARG OPENCODE_VERSION=1.19.3
ARG OPENCODE_SHA256_X64=13a8fb2978302071b86f9d7e00da9c8895f9cd846978379c3bdc6a5333536c9b
ARG OPENCODE_SHA256_ARM64=7900818a6a98881edbbadab4b7525940eff3b9750040c200481f9f56cacee405
ARG TARGETARCH

COPY --from=ghcr.io/astral-sh/uv:0.8.24@sha256:1d31be550ff927957472b2a491dc3de1ea9b5c2d319a9cea5b6a48021e2990a6 /uv /uvx /usr/local/bin/

RUN apt-get update && apt-get install -y --no-install-recommends libexpat1 ca-certificates curl \
    tesseract-ocr tesseract-ocr-eng tesseract-ocr-jpn libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*

# The glibc build (the base image is Debian), installed as root in /usr/local/bin so the unprivileged user
# cannot update it. User state lives in the container's /home/geo and is thrown away with the container.
RUN case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
      amd64) asset=opencode-linux-x64.tar.gz; sum=${OPENCODE_SHA256_X64} ;; \
      arm64) asset=opencode-linux-arm64.tar.gz; sum=${OPENCODE_SHA256_ARM64} ;; \
      *) echo "unsupported arch" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /tmp/opencode.tar.gz \
    "https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_VERSION}/${asset}" \
 && echo "${sum}  /tmp/opencode.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/opencode.tar.gz -C /usr/local/bin opencode \
 && rm /tmp/opencode.tar.gz \
 && chmod 0755 /usr/local/bin/opencode \
 && { test "$(/usr/local/bin/opencode --version)" = "${OPENCODE_VERSION}" \
      || { echo "opencode is $(/usr/local/bin/opencode --version), not ${OPENCODE_VERSION}" >&2; exit 1; }; }

# The libraries the skills' scripts import (the first line of each test file lists them), at exact versions.
COPY evals/agents/requirements-evals.lock /tmp/requirements-evals.lock
RUN uv venv /opt/venv && VIRTUAL_ENV=/opt/venv uv pip install --no-cache --no-deps -r /tmp/requirements-evals.lock \
 && rm /tmp/requirements-evals.lock

# The thread counts are cooperative; the hard limits come from docker run (see run_opencode_docker.sh).
ENV PATH=/opt/venv/bin:$PATH \
    UV_CACHE_DIR=/opt/uv-cache \
    HOME=/home/geo \
    OMP_NUM_THREADS=8 \
    OPENBLAS_NUM_THREADS=8 \
    MKL_NUM_THREADS=8 \
    NUMEXPR_NUM_THREADS=8
# OPENCODE_DISABLE_AUTOUPDATE: no update checks. OPENCODE_DISABLE_CLAUDE_CODE: do not read ~/.claude or .claude
# (prompt and skills); the other agents do not read them either. OPENCODE_DISABLE_LSP_DOWNLOAD: no language servers
# fetched in the middle of a run.
ENV OPENCODE_DISABLE_AUTOUPDATE=1 \
    OPENCODE_DISABLE_CLAUDE_CODE=1 \
    OPENCODE_DISABLE_LSP_DOWNLOAD=1

# The agents run commands in a login shell, and Debian's /etc/profile resets PATH; put the venv back.
RUN echo 'export PATH=/opt/venv/bin:$PATH' > /etc/profile.d/venv.sh

RUN useradd --uid 1000 --create-home --home-dir /home/geo geo \
 && mkdir -p /opt/uv-cache /work && chown -R geo /opt/uv-cache /work /home/geo
USER geo
RUN python -c "import cv2, skimage, pypdfium2, pyproj" && tesseract --list-langs

WORKDIR /work
CMD ["bash"]
