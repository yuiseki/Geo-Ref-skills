# Codex CLI, plus the toolchain of the skills (tesseract, OpenCV, pypdfium2, pyproj) and ripgrep
# (most agents' system prompts tell them to search with rg), for the agent benchmark in
# evals/agents/ under hard resource limits. The five images (claude, codex, gemini, opencode, qoder) differ only in
# the agent's CLI and its settings, so the runs compare agents and models, not environments; keep the shared lines in
# step (evals/agents/test_dockerfiles.py checks them). Adapted from GeoAI-master-skills.
# Build (from the repository root):  docker build -f evals/Dockerfile.evals.codex -t geo-ref-skills-evals-codex .
# Run:    evals/agents/run_codex_docker.sh <workdir>     (the limits are set there, not here)
# Pinned inputs, so a later rebuild gives the same toolchain: the base images by digest, the CLI by version, the
# Python packages from evals/agents/requirements-evals.lock. Only the Debian packages come from apt at build time.
FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258

# Pinned for reproducibility; override with --build-arg CODEX_VERSION=... and record it with the results.
ARG CODEX_VERSION=0.162.1
ARG TARGETARCH

COPY --from=ghcr.io/astral-sh/uv:0.8.24@sha256:1d31be550ff927957472b2a491dc3de1ea9b5c2d319a9cea5b6a48021e2990a6 /uv /uvx /usr/local/bin/

RUN apt-get update && apt-get install -y --no-install-recommends libexpat1 ca-certificates curl \
    tesseract-ocr tesseract-ocr-eng tesseract-ocr-jpn libglib2.0-0 ripgrep \
 && rm -rf /var/lib/apt/lists/*

# The Codex release binaries (musl, static), kept apart from the user state in /home/geo/.codex.
# codex-code-mode-host is a separate asset that codex starts to run commands; without it every
# command fails with "No such file or directory".
RUN case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
      amd64) triple=x86_64-unknown-linux-musl ;; \
      arm64) triple=aarch64-unknown-linux-musl ;; \
      *) echo "unsupported arch" >&2; exit 1 ;; \
    esac \
 && curl -fsSL "https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/codex-${triple}.tar.gz" \
    | tar -xz -C /usr/local/bin \
 && mv "/usr/local/bin/codex-${triple}" /usr/local/bin/codex \
 && curl -fsSL "https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/codex-code-mode-host-${triple}.tar.gz" \
    | tar -xz -C /usr/local/bin \
 && mv "/usr/local/bin/codex-code-mode-host-${triple}" /usr/local/bin/codex-code-mode-host \
 && chmod 0755 /usr/local/bin/codex /usr/local/bin/codex-code-mode-host \
 && test "$(codex --version)" = "codex-cli ${CODEX_VERSION}"

# The libraries the skills' scripts import (the first line of each test file lists them), at exact versions.
COPY evals/agents/requirements-evals.lock /tmp/requirements-evals.lock
RUN uv venv /opt/venv && VIRTUAL_ENV=/opt/venv uv pip install --no-cache --no-deps -r /tmp/requirements-evals.lock \
 && rm /tmp/requirements-evals.lock

# The thread counts are cooperative; the hard limits come from docker run (see run_codex_docker.sh).
ENV PATH=/opt/venv/bin:$PATH \
    UV_CACHE_DIR=/opt/uv-cache \
    HOME=/home/geo \
    OMP_NUM_THREADS=8 \
    OPENBLAS_NUM_THREADS=8 \
    MKL_NUM_THREADS=8 \
    NUMEXPR_NUM_THREADS=8

# The agents run commands in a login shell, and Debian's /etc/profile resets PATH; put the venv back.
RUN echo 'export PATH=/opt/venv/bin:$PATH' > /etc/profile.d/venv.sh

RUN useradd --uid 1000 --create-home --home-dir /home/geo geo \
 && mkdir -p /opt/uv-cache /work /home/geo/.codex && chown -R geo /opt/uv-cache /work /home/geo
USER geo
RUN python -c "import cv2, skimage, pypdfium2, pyproj" && tesseract --list-langs && rg --version

WORKDIR /work
CMD ["bash"]
